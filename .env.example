# Server configuration
RSDLP_BIND_ADDRESS=0.0.0.0:3000

# Logging level (optional, defaults to info: trace, debug, info, warn, error)
RSDLP_LOG=info

# Telegram configuration (optional)
# Obtain API ID & HASH from https://my.telegram.org
RSDLP_TG_API_ID=
RSDLP_TG_API_HASH=

# Bot token from @BotFather (optional, omit for user account phone login)
RSDLP_TG_BOT_TOKEN=

# SQLite session file path (optional, defaults to rsdlp.session)
RSDLP_TG_SESSION_FILE=rsdlp.session
